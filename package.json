{
  "name": "stack-trace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "bun run --filter api start:dev",
    "dev:web": "bun run --filter web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "bun run --filter api test:coverage",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "check": "bun run format:check && turbo run lint typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli:doctor": "bun run --filter api cli -- doctor",
    "worker:smoke": "bun run --filter api worker:smoke",
    "deps:audit": "bun run --filter api deps:audit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:logs": "docker compose logs --follow postgres",
    "db:shell": "docker compose exec postgres psql -U stack_trace -d stack_trace",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.58.0",
    "portless": "^0.15.6",
    "prettier": "^3.4.2",
    "turbo": "^2.5.4"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "oxlint --config apps/api/oxlint.json --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
