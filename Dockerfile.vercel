# syntax=docker/dockerfile:1
FROM oven/bun:1 AS build
WORKDIR /repo

# Copy the whole monorepo so bun resolves all workspaces from the lockfile
COPY package.json bun.lock turbo.json ./
COPY apps ./apps
COPY packages ./packages

# Install every workspace exactly as lockfile pins
RUN bun install --frozen-lockfile

# Build the shared-types package first (web depends on it via workspace:*)
RUN bun run --filter shared-types build

# Build only the web app in standalone mode
ENV NEXT_TELEMETRY_DISABLED=1
ENV SKIP_ENV_VALIDATION=1
RUN bun run --filter web build

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=80
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

# Copy the ENTIRE standalone root. It contains both the app (apps/web) and its
# sibling node_modules (the Bun .bun store + dep graph), which the app's symlinks
# resolve against. Copying only apps/web breaks those relative symlinks.
COPY --from=build /repo/apps/web/.next/standalone/ ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/static /app/apps/web/.next/static
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/public /app/apps/web/public

USER nextjs

WORKDIR /app/apps/web
EXPOSE 80
CMD ["node", "server.js"]
