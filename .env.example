NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Zero means forwarded proxy headers are not trusted.
# Use a positive hop count only when the deployment
# topology is known and controlled.
TRUST_PROXY_HOPS=0
# Development logs are readable.
# Production must set LOG_PRETTY=false.
LOG_LEVEL=debug
LOG_PRETTY=true

# Maximum JSON/raw request-body size.
HTTP_BODY_LIMIT_BYTES=1048576
